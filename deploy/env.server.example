# Server environment: /root/verifi/.env (chmod 600).
# Generated secrets: openssl rand -hex 24

POSTGRES_PASSWORD=
DASHBOARD_TOKEN=
LITELLM_MASTER_KEY=
TELEGRAM_WEBHOOK_SECRET=
# Shared secret guarding the core /internal money surface. Set the same value
# for core-api and verify-api. When empty, core falls back to network
# isolation only.
CORE_INTERNAL_SECRET=

DEEPSEEK_API_KEY=
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_ID=

PUBLIC_BASE_URL=https://verifi.cloud
# Bind nginx to the server's public IPv4 so Tailscale can own 443 on its
# private address without racing Docker after a restart.
PUBLIC_BIND_IP=YOUR_SERVER_PUBLIC_IPV4
BOT_MODE=polling
FREE_COMMISSION_USD=0.50
# Cap on free admissions per UTC day across all wallets (0 = unlimited).
# Recommended: set a finite ceiling so invented wallets cannot drain free
# human work. Over budget, callers fall through to paid x402.
FREE_DAILY_MAX=500
REQUEST_AUDIT_RETENTION_DAYS=30

# x402 payments through the self-hosted facilitator.
# X402_PAY_TO: the receiving wallet address (public), revenue lands here.
# FACILITATOR_PRIVATE_KEY: the gas wallet private key, keep only 5-10 EUR
#   of ETH on Base in it. Never the treasury wallet key.
# When going live: FACILITATOR_URL=http://facilitator:8080 and start the
#   facilitator with the "payments" compose profile.
X402_PAY_TO=
X402_ENTRY_PRICE=$0.10
X402_UNLOCK_PRICE=$2.90
X402_NETWORK=eip155:8453
FACILITATOR_URL=https://x402.org/facilitator
FACILITATOR_PRIVATE_KEY=

# FACILITATOR_ADDRESS is the PUBLIC address of the gas wallet whose key is in
# FACILITATOR_PRIVATE_KEY. core-api watches its balance and alerts the operator
# before the gas till empties and settlements stop. Public address only:
# core-api refuses to start if a private key reaches its environment.
FACILITATOR_ADDRESS=
BASE_RPC_URL=https://mainnet.base.org
GAS_LOW_ETH=0.002

# Contract v3 pricing. Prices are set in euros. EURC is charged these amounts,
# USDC the amount converted at the ECB reference rate, rounded up to the cent
# and locked at admission. GRACE_SECONDS must exceed SLA_SECONDS, or be 0 for
# no grace window; GRACE_UNLOCK_EUR must not exceed SLA_UNLOCK_EUR. The core
# API refuses to start otherwise.
PRICE_BASIS=EUR
ADMISSION_EUR=0.10
SLA_UNLOCK_EUR=2.90
GRACE_UNLOCK_EUR=1.45
SLA_SECONDS=3600
GRACE_SECONDS=86400
QUOTE_VALID_SECONDS=600
# Offered in this order. USDC first keeps agents whose x402 client picks the
# first option paying in the asset they hold.
X402_ASSETS=USDC,EURC
FX_STALE_DAYS=7
